{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "KeyVaultConfig": {
    "Endpoint": "https://storezonesqlconn.vault.azure.net/",
    "ClientId": "REDACTED_CLIENT_ID",
    "TenantId": "REDACTED_TENANT_ID",
    "ClientSecret": "REDACTED_CLIENT_SECRET",
    "SecretName": "REDACTED_SECRET_NAME",
    "CertificateName": "REDACTED_CERTIFICATE_NAME",
    "CertificatePassword": "REDACTED_CERTIFICATE_PASSWORD",
    "UseManagedIdentity": false,
    "ManagedIdentityClientId": "REDACTED_MANAGED_IDENTITY_CLIENT_ID",
    "UseCertificateAuthentication": false,
    "UseClientSecretAuthentication": true,
    "Retry": {
      "MaxRetries": 5,
      "DelayInMilliseconds": 200,
      "MaxDelayInMilliseconds": 5000
    },
    "TimeoutInSeconds": 10,
    "EnableLogging": true,
    "LogSensitiveInformation": false,
    "CacheExpirationInMinutes": 60,
    "RefreshIntervalInMinutes": 15,
    "UseInMemoryCache": true,
    "UseDistributedCache": false,
    "DistributedCacheConnectionString": "REDACTED_DISTRIBUTED_CACHE_CONNECTION_STRING",
    "DistributedCacheKeyPrefix": "StoreZoneV2API_",
    "DistributedCacheExpirationInMinutes": 60,
    "EnableSecretVersioning": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

}
